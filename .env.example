# Prompt Royale Backend Environment Configuration Example

# Database Connection (Required - Server halts if missing)
DATABASE_URL=sqlite+aiosqlite:///./data/promptroyale.db
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

JWT_SECRET_KEY=change-this-to-a-secure-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GEMINI_API_KEY=
